{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fleet driver — one orchestrator directs cross-vendor coding-tool workers through AI/AX and an authenticated web command surface, with reliable control, a hard-to-fool trust gate, and structural code evidence.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "baton": "scripts/baton.mjs",
    "baton-mcp": "scripts/mcp-stdio.mjs",
    "baton-mcp-web": "scripts/mcp-web.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./impl": "./src/index.mjs",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "scripts",
    "MCP.md",
    "CLI.md"
  ],
  "scripts": {
    "test": "node scripts/run-suite.mjs",
    "test:watch": "node scripts/run-suite.mjs --watch",
    "demo": "node demo.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@ast-grep/napi": "0.44.1"
  },
  "optionalDependencies": {
    "@mozilla/readability": "0.5.0"
  }
}
