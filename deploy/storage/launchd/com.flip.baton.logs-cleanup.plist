<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Deployment template for the qualified immutable log-clean helper. Root
  deploys it from a release that contains libexec/baton2/logs-clean-all.

  Run as the database owner with the standard Baton environment. Do not add
  credentials to this agent.

  The helper prints one JSON object to stdout:
    {"results":[<one logs-clean response per registered session>]}
  It enumerates session IDs from the database and calls the canonical
  Logs.clean_all sequentially. Each session takes its lock, rereads pending
  input and applies the settlement checks. Temporary scratch and build outputs
  are not database candidates.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.flip.baton.logs-cleanup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/qualified-release/libexec/baton2/logs-clean-all</string>
    <string>/path/to/state.db</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/path/to/PROJECT</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/path/to/PROJECT/logs/baton-logs-cleanup.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/PROJECT/logs/baton-logs-cleanup.stderr</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
