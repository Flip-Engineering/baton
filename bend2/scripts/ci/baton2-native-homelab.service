[Unit]
Description=Baton2 admitted homelab Linux validation runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=batonci
Group=batonci
RuntimeDirectory=baton2-native-homelab
RuntimeDirectoryMode=0700
BindPaths=/mnt/nvme4tb/ci-runners/baton2-native-homelab:/run/baton2-native-homelab
WorkingDirectory=/run/baton2-native-homelab/runner
ExecStart=/bin/sh -c "exec /run/baton2-native-homelab/runner/runsvc.sh"
Restart=on-failure
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=infinity
UMask=0077
Environment=HOME=/run/baton2-native-homelab/home
Environment=TMPDIR=/run/baton2-native-homelab/temp
Environment=RUNNER_TOOL_CACHE=/run/baton2-native-homelab/tool-cache
Environment=PATH=/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/mnt/nvme4tb/ci-runners/baton2-native-homelab
ReadWritePaths=/run/baton2-native-homelab
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
LimitCORE=0

[Install]
WantedBy=multi-user.target
