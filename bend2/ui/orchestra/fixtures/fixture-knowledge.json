    "nodes": [
      {
        "id": "fixture-finding-a1",
        "author": "fixture-knowledge-player-a",
        "claim": "The snapshot read stays authoritative while the event stream reconnects.",
        "evidence": "message:fixture-message-1",
        "limits": "Measured against a local database; a remote event source was not exercised.",
        "kind": "finding",
        "evidenceMessage": {
          "id": "fixture-message-1",
          "sender": "fixture-knowledge-player-a",
          "recipient": "fixture-knowledge-conductor-a",
          "body": "Two reconnect cycles during a restart left the snapshot read authoritative: the page served the recorded rows and the stream resumed from its cursor."
        },
        "reference": "finding:fixture-finding-a1",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-a2",
        "author": "fixture-knowledge-player-a",
        "claim": "A busy database read is recoverable; the page retries the snapshot.",
        "evidence": "message:fixture-message-1",
        "limits": "The retry interval is one second and was observed against a single writer.",
        "kind": "finding",
        "reference": "finding:fixture-finding-a2",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-a3",
        "author": "fixture-knowledge-player-a",
        "claim": "Recorded execution state is not process liveness.",
        "evidence": "A session whose execution row read exited served a completed turn when the record was read again.",
        "limits": "The database carries no process observation for the sessions in this set.",
        "kind": "finding",
        "reference": "finding:fixture-finding-a3",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-a4",
        "author": "fixture-knowledge-player-a",
        "claim": "A pending count is the count of stored messages with no receipt.",
        "evidence": "A message inserted with no receipt raised the recipient count by one.",
        "limits": "Counts describe stored messages; delivery to a harness process is not recorded.",
        "kind": "finding",
        "reference": "finding:fixture-finding-a4",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-b1",
        "author": "fixture-knowledge-conductor-a",
        "claim": "Selection survives an event that replaces a row.",
        "evidence": "A player event replaced the selected row and the selection marker stayed on the same actor.",
        "limits": "Observed for a player event whose parent did not change.",
        "kind": "finding",
        "reference": "finding:fixture-finding-b1",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-b2",
        "author": "fixture-knowledge-conductor-a",
        "claim": "A knowledge read is on demand, so the snapshot carries no claims.",
        "evidence": "The snapshot payload for this fixture carries no claim text; the band reads the overview document instead.",
        "limits": "Applies to the two knowledge routes; other projections may carry summaries.",
        "kind": "finding",
        "reference": "finding:fixture-finding-b2",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-b3",
        "author": "fixture-knowledge-conductor-a",
        "claim": "An ensemble carries its coupling, and membership carries no trust.",
        "evidence": "The fixture ensemble records coupling tight and four members with no ordering.",
        "limits": "Coupling is a recorded field of the ensemble row.",
        "kind": "finding",
        "reference": "finding:fixture-finding-b3",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-c1",
        "author": "fixture-knowledge-conductor-b",
        "claim": "A stopped session keeps its worktree, branch and pending input.",
        "evidence": "message:fixture-message-2",
        "limits": "The stop record names the recorded attempt and no live process.",
        "kind": "finding",
        "evidenceMessage": null,
        "reference": "finding:fixture-finding-c1",
        "referenceOnly": false
      },
      {
        "id": "fixture-finding-c2",
        "author": "fixture-knowledge-conductor-b",
        "claim": "A report reaches the immediate parent.",
        "evidence": "The fixture transition list records the report against the sender's parent row.",
        "limits": "Observed within one hierarchy of three levels.",
        "kind": "finding",
        "reference": "finding:fixture-finding-c2",
        "referenceOnly": false
      },
      {
