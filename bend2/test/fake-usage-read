#!/bin/sh
# Test usage-read helper for test/usage-live-reads.bend. The core runs it as
# HELPER PROVIDER CREDENTIAL_REF. The fixture gives each account the reference
# file:PATH and writes the next read document to PATH; this prints that document.
# serial:DIR records overlapping requests while returning DIR/answer.
# A claude-oauth: or codex-home: reference prints an unreadable read whose reason
# is the received reference, so a fixture can check which store was selected.
case "$2" in
  serial:*)
    directory=${2#serial:}
    if mkdir "$directory/active" 2>/dev/null; then
      sleep 0.3
      cat "$directory/answer"
      rmdir "$directory/active"
    else
      touch "$directory/overlap"
      cat "$directory/answer"
    fi
    ;;
  file:*) cat "${2#file:}" ;;
  claude-oauth:*|codex-home:*)
    printf '{"schema":"baton2-usage-read-v1","provider":"%s","source":"fixture","observedAt":1,"state":"unreadable","reason":"reference %s"}' "$1" "$2"
    ;;
  *) echo "unexpected reference" >&2; exit 2 ;;
esac
