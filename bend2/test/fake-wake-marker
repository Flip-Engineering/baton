#!/bin/sh
# Test self for the usage hold reset-time continuation. The scheduler runs the
# self as: SELF --wake-message DB MESSAGE. This stands in for the coordinator
# wake driver: it re-checks the message and the hold when it fires. The hold
# derives from the newest readable usage_reads row for the recipient's provider
# (the model prefix) and account (the fixture uses the seat id as the account):
# the seat is held when that read has a window marked exhausted or at 100 percent
# used. A message the recipient already read is a no-op; a held seat records a
# check and delivers nothing; an open seat records one delivery and one report, so
# a repeated continuation changes nothing. The recipient-owned read row is
# recorded by the coordinator when the recipient reads the input; this marker
# writes no messaging state.
db=$2
msg=$3
recipient=$(sqlite3 "$db" "SELECT coalesce((SELECT recipient FROM messages WHERE id='$msg'),'');")
pending=$(sqlite3 "$db" "SELECT count(*) FROM messages WHERE id='$msg' AND NOT EXISTS(SELECT 1 FROM message_reads r WHERE r.message=messages.id AND r.recipient=messages.recipient);")
[ "$pending" = "1" ] || exit 0
held=$(sqlite3 "$db" "SELECT EXISTS(SELECT 1 FROM json_each((SELECT r.document FROM usage_reads r WHERE r.account='$recipient' AND r.provider=(SELECT CASE WHEN instr(model,'/')>0 THEN substr(model,1,instr(model,'/')-1) ELSE '' END FROM sessions WHERE id='$recipient') AND r.state='read' ORDER BY r.id DESC LIMIT 1),'\$.windows') w WHERE coalesce(json_extract(w.value,'\$.exhausted'),0)=1 OR coalesce(json_extract(w.value,'\$.usedPercent'),0)>=100);")
if [ "$held" = "1" ]; then
  sqlite3 "$db" "INSERT OR IGNORE INTO wake_held_checks(id) VALUES('$msg');"
  exit 0
fi
sqlite3 "$db" "INSERT OR IGNORE INTO wake_deliveries(message,receipt) VALUES('$msg','delivered');"
sqlite3 "$db" "INSERT OR IGNORE INTO wake_reports(id) VALUES('$msg:wake-delivered-report');"
