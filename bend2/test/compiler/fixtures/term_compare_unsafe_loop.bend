    spin_again(result,unit => spin(name))

def spin_named(+name: String) -> IO(Unit):
  spin(name)

law a_law_reaching_an_unsafe_loop_finishes:
  for +name: String
  {spin_named(name) == spin(name) : IO(Unit)}

def a_law_reaching_an_unsafe_loop_finishes(name):
  {==}

def main() -> U32:
  0
