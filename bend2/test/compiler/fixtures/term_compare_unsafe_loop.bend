# A law whose two sides reach an @unsafe loop that recurses under a lambda. Each
# pass through the loop compares long strings, as a store write does, so the
# unfolding grows memory steadily on a compiler that unfolds the loop.
import Base

def spin_again(result: Result<&1,&1,U32 & String,String>, again: Unit -> IO(Unit)) -> IO(Unit):
  match result:
    case Fail{error}: again(Unit{})
    case Done{value}: IO.pure(Unit,Unit{})

@unsafe
def spin(+name: String) -> IO(Unit):
  do IO<Unit>:
    step0 : Result<&1,&1,U32 & String,String> <- IO.get_env("SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = SELECT session, account, model, recorded, status FROM attempts WHERE session = " ++ name)
