+// BEND_CGEN_CACHE_LOG puts one event per compile on stderr: disabled,
+// no-manifest, miss, miss-invalid, hit, store or no-store. It is unset by
+// default, and a diagnostic never changes the text a compile returns.
+function log_line(event: string, detail: string): void {
+  if (process.env.BEND_CGEN_CACHE_LOG === undefined) {
+    return;
+  }
+  try {
+    fs.writeSync(2, "cgen-cache: " + event + " " + detail + "\n");
+  } catch {
+    // Diagnostics must never change a compile.
+  }
+}
