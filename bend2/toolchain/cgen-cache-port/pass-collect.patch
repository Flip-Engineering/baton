     const pass_number = ++diagnostic_pass;
+    collect_full();
     diagnostic("pass.begin", { pass: pass_number, definitions: defs.length,
       own: cb.own.size, hot: cb.hot.size, stat: cb.stat.size, dry });
     [cb.lend, BRWS].forEach((m) => m.clear());
@@ -3688,6 +3699,7 @@
