From: Lorenzo Battistela <lorenzobattistela@gmail.com>
Subject: Exclude constructors when resolving term variables
Upstream source: flip-engineer/bend fix-1236-ctor-shadow at da49ccd09f68cff69fefecd7a59aa2be94c897fd

This patch is adapted to Baton’s selected Bend source. The original change
added an optional constructor lookup argument to a newer resolver. The pinned
2.0.25 resolver has a simpler fallback, so this adaptation preserves its
existing return behavior except when an unqualified name collides only with a
constructor.

This patch is for a future compiler-source release. It does not alter the
currently selected compiler archive or its lock.

diff --git a/bend2/compiler/upstream/bend.ts b/bend2/compiler/upstream/bend.ts
--- a/bend2/compiler/upstream/bend.ts
+++ b/bend2/compiler/upstream/bend.ts
@@ -1976,6 +1976,6 @@ export function parse_var(p: Parse, k: Name, s?: Span): LTerm {
     return Var(k, e[1], s);
   }
-  const q = parse_reso(p, k);
+  const q = parse_reso(p, k, false);
   if (k.includes(".")) {
     return Ref(q, s);
   }
@@ -1989,4 +1989,4 @@ export function parse_reso(p: Parse, k: Name): Name {
-export function parse_reso(p: Parse, k: Name): Name {
+export function parse_reso(p: Parse, k: Name, ctr = true): Name {
   const dot = k.indexOf(".");
   let q = parse_qual(p, k);
   if (dot !== -1 && k.slice(0, dot) in p.al) {
@@ -1995,5 +1995,8 @@ export function parse_reso(p: Parse, k: Name, ctr = true): Name {
   if (q in p.book.tlds || q in p.book.ctrs) {
     return q;
   }
+  if (!ctr && !(k in p.book.tlds) && k in p.book.ctrs) {
+    return q;
+  }
   return k;
 }
