From 89cbf921382f6007505876967b804031decde710 Mon Sep 17 00:00:00 2001
From: flip-engineer <will.a.hargis@gmail.com>
Date: Sat, 17 Oct 2026 18:12:19 -0700
Subject: [PATCH 1/2] Require an admission guard on the fork compiler launcher

When the selected compiler is a shell launcher, refuse selection unless it
contains the build-admission guard marker. Official ELF compilers are unchanged
and keep their separate packaging path.
---
 .github/scripts/prepare-native-compiler.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/.github/scripts/prepare-native-compiler.py b/.github/scripts/prepare-native-compiler.py
index 51176f02..bc1d6014 100644
--- a/.github/scripts/prepare-native-compiler.py
+++ b/.github/scripts/prepare-native-compiler.py
@@ -48,6 +48,10 @@ def main():
     binary_sha = digest(compiler)
     if 'binary_sha256' in identity:
         require(binary_sha == identity['binary_sha256'], 'The selected compiler binary changed.')
+    if compiler.read_bytes()[:2] == b'#!':
+        launcher = compiler.read_text(errors='replace')
+        require('build-admission-required' in launcher,
+                'The fork compiler launcher lacks the build admission guard.')
     selection = {'schema': 'baton2-linux-compiler-selection-v1', **identity,
                  'selection': 'retained' if selected else 'downloaded',
                  'compiler_archive_sha256': archive_sha, 'compiler_binary_sha256': binary_sha,
-- 
