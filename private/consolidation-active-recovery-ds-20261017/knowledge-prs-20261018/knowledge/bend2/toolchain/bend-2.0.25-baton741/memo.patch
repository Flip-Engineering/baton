+function weak_memo<K extends object, V>(m: WeakMap<K, V>, k: K, f: () => V): V {
+  const got = m.get(k);
+  if (got !== undefined) {
+    return got;
+  }
+  const out = f();
+  m.set(k, out);
+  return out;
