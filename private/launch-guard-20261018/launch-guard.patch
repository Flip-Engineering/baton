From d4c3bdafc05412d4ab85397e17495f1faab5a059 Mon Sep 17 00:00:00 2001
From: flip-engineer <will.a.hargis@gmail.com>
Date: Sat, 17 Oct 2026 17:42:36 -0700
Subject: [PATCH 07/12] Guard packaged compiler against unadmitted Main
 generation

Refuse a coordinator Main C generation from the pinned Bend wrapper unless
the invoking process carries a /sys/fs/cgroup path with a finite memory.max
and a matching admitted full receipt. Focused entries, version queries and
--check-only calls pass through. No opt-out variable is accepted.

The fixture uses a stub compiler and an actual bounded host cgroup probe.
---
 bend2/scripts/bend-launch-guard.sh | 87 +++++++++++++++++++++++++++++
 bend2/test/bend-launch-guard.sh    | 88 ++++++++++++++++++++++++++++++
 2 files changed, 175 insertions(+)
 create mode 100755 bend2/scripts/bend-launch-guard.sh
 create mode 100755 bend2/test/bend-launch-guard.sh

diff --git a/bend2/scripts/bend-launch-guard.sh b/bend2/scripts/bend-launch-guard.sh
new file mode 100755
index 00000000..625257e6
--- /dev/null
+++ b/bend2/scripts/bend-launch-guard.sh
@@ -0,0 +1,87 @@
+#!/bin/sh
+# Narrow bootstrap launch guard for the packaged Bend compiler.
+#
+# The product admission policy remains the native Bend2 design in
+# docs/bend2/build-admission.md. This wrapper refuses a coordinator Main C
+# generation unless the invoking process carries an admitted bounded cgroup and
+# a matching decision receipt. Focused entries, version queries and
+# --check-only calls pass through unchanged.
+#
+# The canonical path is a delegated cgroup under /sys/fs/cgroup with a finite
+# memory.max. There is no opt-out variable.
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
+
+entry=
+output=
+check_only=0
+query=0
+expect_output=0
+for argument in "$@"; do
+  if [ "$expect_output" = 1 ]; then
+    output=$argument
+    expect_output=0
+    continue
+  fi
+  case "$argument" in
+    -o|--output)
+      expect_output=1
+      ;;
+    --check-only|version|--version)
+      check_only=1
+      ;;
+    -)
+      ;;
+    -*)
+      ;;
+    *)
+      if [ -z "$entry" ]; then
+        entry=$argument
+      fi
+      ;;
+  esac
+done
+
+full=0
+case "$entry" in
+  */bend2/src/coordinator/main.bend|bend2/src/coordinator/main.bend)
+    full=1
+    ;;
+esac
+
+refuse() {
+  printf '{"error":"build-admission-required","condition":"%s","entry":"%s","output":"%s","cgroup":"%s","receipt":"%s","next":"Run the build through the admitted cgroup and receipt, or use a focused entry."}\n' \
+    "$1" "$entry" "$output" "${BATON2_ADMISSION_CGROUP:-}" "${BATON2_ADMISSION_RECEIPT:-}" >&2
+  exit 78
+}
+
+if [ "$full" = 1 ] && [ "$check_only" = 0 ]; then
+  cgroup=${BATON2_ADMISSION_CGROUP:-}
+  receipt=${BATON2_ADMISSION_RECEIPT:-}
+  [ -n "$cgroup" ] || refuse "missing-cgroup"
+  [ -d "$cgroup" ] || refuse "missing-cgroup-directory"
+  case "$cgroup" in
+    /sys/fs/cgroup/*) ;;
+    *) refuse "cgroup-outside-canonical-root" ;;
+  esac
+  maximum=
+  if [ -r "$cgroup/memory.max" ]; then
+    maximum=$(cat "$cgroup/memory.max")
+  fi
+  [ -n "$maximum" ] || refuse "missing-memory-max"
+  [ "$maximum" != max ] || refuse "unbounded-cgroup"
+  case "$maximum" in
+    ''|*[!0-9]*) refuse "invalid-memory-max" ;;
+  esac
+  [ "$maximum" -gt 0 ] || refuse "invalid-memory-max"
+  [ -f "$receipt" ] || refuse "missing-receipt"
+  grep -q '"decision"[[:space:]]*:[[:space:]]*"admitted"' "$receipt" || refuse "receipt-not-admitted"
+  grep -q '"class"[[:space:]]*:[[:space:]]*"full"' "$receipt" || refuse "receipt-not-full"
+  grep -Fq "\"entry\": \"$entry\"" "$receipt" || refuse "receipt-entry-mismatch"
+  if [ -n "$output" ]; then
+    grep -Fq "\"output\": \"$output\"" "$receipt" || refuse "receipt-output-mismatch"
+  fi
+fi
+
+exec "$root/bin/bun" --smol "$root/bend2/main.ts" "$@"
diff --git a/bend2/test/bend-launch-guard.sh b/bend2/test/bend-launch-guard.sh
new file mode 100755
index 00000000..3d234091
--- /dev/null
+++ b/bend2/test/bend-launch-guard.sh
@@ -0,0 +1,88 @@
+#!/bin/sh
+# Focused fixture for bend2/scripts/bend-launch-guard.sh.
+# The compiler is a stub. The admitted case uses an actual host cgroup with a
+# finite memory.max as the bounded probe; no Main generation runs.
+set -eu
+
+here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+guard="$here/../scripts/bend-launch-guard.sh"
+temp=$(mktemp -d)
+trap 'rm -rf "$temp"' EXIT HUP INT TERM
+
+mkdir -p "$temp/bin" "$temp/bend2"
+cp "$guard" "$temp/bin/bend"
+chmod 0755 "$temp/bin/bend"
+cat > "$temp/bin/bun" <<'STUB'
+#!/bin/sh
+printf '%s\n' "$*" >> "$BUN_STUB_LOG"
+exit 0
+STUB
+chmod 0755 "$temp/bin/bun"
+printf '// stub compiler entry\n' > "$temp/bend2/main.ts"
+export BUN_STUB_LOG="$temp/calls.log"
+
+probe=
+for candidate in /sys/fs/cgroup/*; do
+  [ -r "$candidate/memory.max" ] || continue
+  maximum=$(cat "$candidate/memory.max" 2>/dev/null || true)
+  case "$maximum" in
+    ''|max|*[!0-9]*) continue ;;
+  esac
+  if [ "$maximum" -gt 0 ]; then
+    probe=$candidate
+    break
+  fi
+done
+[ -n "$probe" ] || { echo "FAIL no bounded cgroup probe"; exit 1; }
+echo "bounded_probe=$probe memory.max=$(cat "$probe/memory.max")"
+
+calls() { if [ -f "$BUN_STUB_LOG" ]; then wc -l < "$BUN_STUB_LOG"; else echo 0; fi; }
+
+"$temp/bin/bend" bend2/src/coordinator/main.bend -o out.c >"$temp/refused.out" 2>"$temp/refused.err" && status=0 || status=$?
+[ "$status" = 78 ] || { echo "FAIL unadmitted status=$status"; cat "$temp/refused.err"; exit 1; }
+grep -q 'build-admission-required' "$temp/refused.err" || { echo "FAIL refusal body"; exit 1; }
+[ "$(calls)" = 0 ] || { echo "FAIL stub ran on refusal"; exit 1; }
+echo "PASS unadmitted_full_refused=78 stub_calls=0"
+
+BATON2_ADMISSION_OPT_OUT=1 "$temp/bin/bend" bend2/src/coordinator/main.bend -o out.c >"$temp/opt.out" 2>"$temp/opt.err" && status=0 || status=$?
+[ "$status" = 78 ] || { echo "FAIL opt-out accepted status=$status"; exit 1; }
+[ "$(calls)" = 0 ] || { echo "FAIL opt-out reached stub"; exit 1; }
+echo "PASS unknown_opt_out_ignored"
+
+unbounded=/sys/fs/cgroup/system.slice/baton2-native-homelab.service
+if [ -r "$unbounded/memory.max" ] && [ "$(cat "$unbounded/memory.max")" = max ]; then
+  cat > "$temp/unbounded.json" <<RECEIPT
+{"decision": "admitted", "class": "full", "entry": "bend2/src/coordinator/main.bend", "output": "out.c"}
+RECEIPT
+  status=0
+  BATON2_ADMISSION_CGROUP="$unbounded" BATON2_ADMISSION_RECEIPT="$temp/unbounded.json" \
+    "$temp/bin/bend" bend2/src/coordinator/main.bend -o out.c >"$temp/unbounded.out" 2>"$temp/unbounded.err" || status=$?
+  [ "$status" = 78 ] || { echo "FAIL unbounded accepted status=$status"; exit 1; }
+  grep -q 'unbounded-cgroup' "$temp/unbounded.err" || { echo "FAIL unbounded cause"; exit 1; }
+  [ "$(calls)" = 0 ] || { echo "FAIL unbounded reached stub"; exit 1; }
+  echo "PASS unbounded_cgroup_refused"
+fi
+
+status=0; "$temp/bin/bend" bend2/test/tiny.bend -o out.c >"$temp/focused.out" 2>"$temp/focused.err" || status=$?
+[ "${status:-0}" = 0 ] || { echo "FAIL focused status=$status"; cat "$temp/focused.err"; exit 1; }
+[ "$(calls)" = 1 ] || { echo "FAIL focused stub_calls=$(calls)"; exit 1; }
+echo "PASS focused_entry_allowed"
+
+status=0; "$temp/bin/bend" --check-only bend2/src/coordinator/main.bend >"$temp/check.out" 2>"$temp/check.err" || status=$?
+[ "${status:-0}" = 0 ] || { echo "FAIL check-only status=$status"; cat "$temp/check.err"; exit 1; }
+[ "$(calls)" = 2 ] || { echo "FAIL check-only stub_calls=$(calls)"; exit 1; }
+echo "PASS check_only_allowed"
+
+cat > "$temp/receipt.json" <<RECEIPT
+{"decision": "admitted", "class": "full", "entry": "bend2/src/coordinator/main.bend", "output": "out.c", "cgroup": "$probe"}
+RECEIPT
+(
+  ulimit -v 262144
+  BATON2_ADMISSION_CGROUP="$probe" BATON2_ADMISSION_RECEIPT="$temp/receipt.json" \
+    "$temp/bin/bend" bend2/src/coordinator/main.bend -o out.c >"$temp/admitted.out" 2>"$temp/admitted.err"
+) || status=$?
+[ "${status:-0}" = 0 ] || { echo "FAIL admitted status=$status"; cat "$temp/admitted.err"; exit 1; }
+[ "$(calls)" = 3 ] || { echo "FAIL admitted stub_calls=$(calls)"; exit 1; }
+echo "PASS admitted_bounded_probe_allowed rlimit_as=262144KiB"
+
+echo "PASS all launch-guard fixtures"
