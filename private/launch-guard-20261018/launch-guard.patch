From 9d1c48aa289ee725dbbf5e6378aa109b113cafbf Mon Sep 17 00:00:00 2001
From: flip-engineer <will.a.hargis@gmail.com>
Date: Sat, 17 Oct 2026 17:54:18 -0700
Subject: [PATCH 11/12] Bind default Main build to the guarded compiler

Canonicalize the entry with readlink so symlinks are caught, and for the Main
entry require the resolved compiler to be bin/bend and to contain the guard.
The fixture covers the unguarded compiler refusal.
---
 bend2/scripts/build-native.sh   | 13 ++++++++++++-
 bend2/test/bend-launch-guard.sh |  7 +++++++
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/bend2/scripts/build-native.sh b/bend2/scripts/build-native.sh
index ef61bd89..1d0cd25b 100644
--- a/bend2/scripts/build-native.sh
+++ b/bend2/scripts/build-native.sh
@@ -5,7 +5,7 @@ cd "$root"
 entry=${1:-bend2/src/coordinator/main.bend}
 output=${2:-.scratch/bend2/baton2}
 mkdir -p "$(dirname -- "$output")"
-entry_path=$(CDPATH= cd -- "$(dirname -- "$entry")" && pwd -P)/$(basename -- "$entry")
+entry_path=$(readlink -f -- "$entry" 2>/dev/null || printf '%s' "$entry")
 compiler=${BEND:-"$root/.bend/bin/bend"}
 if [ ! -x "$compiler" ]; then
   compiler="$root/node_modules/.bend/bin/bend"
@@ -16,6 +16,17 @@ if [ "$entry_path" = "$root/bend2/src/coordinator/main.bend" ] &&
     "$entry_path" "$output" "${BATON2_ADMISSION_CGROUP:-}" "${BATON2_ADMISSION_RECEIPT:-}" >&2
   exit 78
 fi
+if [ "$entry_path" = "$root/bend2/src/coordinator/main.bend" ]; then
+  compiler_path=$(readlink -f -- "$compiler" 2>/dev/null || printf '%s' "$compiler")
+  case "$compiler_path" in
+    */bin/bend) ;;
+    *) printf '{"error":"build-admission-required","condition":"compiler-not-guarded","compiler":"%s"}\n' "$compiler_path" >&2; exit 78 ;;
+  esac
+  grep -q 'build-admission-required' "$compiler_path" 2>/dev/null || {
+    printf '{"error":"build-admission-required","condition":"compiler-not-guarded","compiler":"%s"}\n' "$compiler_path" >&2
+    exit 78
+  }
+fi
 generated=${BEND_GENERATED_C:-}
 if [ -z "$generated" ] && [ -n "${BATON2_MAIN_GENERATED_C:-}" ] &&
    [ "$entry_path" = "$root/bend2/src/coordinator/main.bend" ]; then
diff --git a/bend2/test/bend-launch-guard.sh b/bend2/test/bend-launch-guard.sh
index 95d303c2..6cb4256f 100755
--- a/bend2/test/bend-launch-guard.sh
+++ b/bend2/test/bend-launch-guard.sh
@@ -129,3 +129,10 @@ BEND="$temp/fake-bend" CC="$temp/fake-cc" sh "$here/../scripts/build-native.sh"
 [ "$status" = 0 ] || { echo "FAIL default focused status=$status"; cat "$temp/default-focused.err"; exit 1; }
 [ -f "$temp/focused-build" ] || { echo "FAIL default focused output"; exit 1; }
 echo "PASS default_build_focused_allowed"
+
+status=0
+BATON2_ADMISSION_CGROUP="$probe" BATON2_ADMISSION_RECEIPT="$temp/receipt.json" \
+  BEND="$temp/fake-bend" CC="$temp/fake-cc" sh "$here/../scripts/build-native.sh" >"$temp/default-unbound.out" 2>"$temp/default-unbound.err" || status=$?
+[ "$status" = 78 ] || { echo "FAIL unguarded compiler status=$status"; cat "$temp/default-unbound.err"; exit 1; }
+grep -q 'compiler-not-guarded' "$temp/default-unbound.err" || { echo "FAIL unguarded compiler cause"; exit 1; }
+echo "PASS default_build_unguarded_compiler_refused"
-- 
