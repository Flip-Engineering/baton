+      +handle : U32 <- IO.try(U32,P.ProcessChild.attach(directory))
+      held : String <- IO.try(String,Text.Text.read("-"))
+      IO.print("observer-holder-released")
+    case _: IO.die(Unit,2,"observer-hold ATTEMPT")
