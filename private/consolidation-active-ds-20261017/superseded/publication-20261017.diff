+  Loc wtl = task_tail(T); \
+  u64 wtw = e.mem[wtl + 1]; \
+  STK(0) = e.mem[wtl]; \
+  STK(1) = (wtw >> 32) & 0xFFFF; \
+  STK(2) = FID_EXIT; \
