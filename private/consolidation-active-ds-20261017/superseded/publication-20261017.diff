+// Main
+// ====
+
+int main(int argc, char** argv) {
+  long thr = 0;
+  int  gpu = -1;
+  u64  mem = 0;
+  io_argv = argv + 1;
+  for (int i = 1; i < argc; i += 1) {
+    const char* a = argv[i];
+    const char* v = i + 1 < argc ? argv[i + 1] : NULL;
+    if (strcmp(a, "--") == 0) {
+      while (i + 1 < argc) {
+        io_argv[io_argc++] = argv[++i];
+      }
+    } else if (strcmp(a, "--help") == 0) {
+      printf(CLI_HELP, argv[0]);
