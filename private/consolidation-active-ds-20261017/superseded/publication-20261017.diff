+
+    def test_scope_path_and_evaluator_refusals_preserve_source(self):
+        for path in ('../outside', 'child/..', '.git/config', 'child/.git'):
+            refused = self.branch('start', '--from', 'source', '--count', '1', '--text', 'Task',
