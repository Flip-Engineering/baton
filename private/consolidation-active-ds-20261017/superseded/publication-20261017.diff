+def U32.inc(a: U32) -> U32:
+  match a:
+    case U32{x}:
+      U32{Word.inc(32n, x)}
+
+def U32.add(a: U32, b: U32) -> U32:
+  match a b:
+    case U32{x} U32{y}:
