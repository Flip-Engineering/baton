+  if (io_nul(name, n)) {
+    q = ENOENT;
+  } else {
+    q = io_get_env(name, &got);
+  }
+  free(name);
+  if (q != 0) {
+    return io_fail(e, q, NULL);
+  }
+  return io_done(e, io_str(e, got, strlen(got)));
