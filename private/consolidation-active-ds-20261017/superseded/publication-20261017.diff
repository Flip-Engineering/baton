+    size_t count=length-offset;if(count>sizeof(chunk))count=sizeof(chunk);
+    for(size_t i=0;i<count;i++)chunk[i]=bytes[offset+i]^mask[(offset+i)%4];
+    error=bc_write(proxy->input,chunk,count);offset+=count;
+  }
