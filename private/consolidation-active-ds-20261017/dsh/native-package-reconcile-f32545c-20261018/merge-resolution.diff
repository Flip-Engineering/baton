+    size_t n = value ? (size_t)sqlite3_column_bytes(statement, i) : 0;
+    char *next = realloc(call->output, call->length + n + 2);
+    if (!next) return 1;
+    call->output = next;
+    if (n) memcpy(next + call->length, value, n);
+    call->length += n;
+    next[call->length++] = i + 1 == count ? '\n' : '\t';
+    next[call->length] = 0;
+  }
+  return 0;
+}
