Subject: [PATCH] Bind completion receipts to current native

---
 bend2/src/coordinator/agent-input.bend    | 10 ++++----
 bend2/src/coordinator/message-status.bend | 12 +++++----
 bend2/src/coordinator/receive.bend        |  8 +++---
 bend2/test/receive.py                     | 30 +++++++++++++++++++++++
 4 files changed, 46 insertions(+), 14 deletions(-)

diff --git a/bend2/src/coordinator/agent-input.bend b/bend2/src/coordinator/agent-input.bend
index b7d94c7e8..63e95b211 100644
--- a/bend2/src/coordinator/agent-input.bend
+++ b/bend2/src/coordinator/agent-input.bend
@@ -404,12 +404,12 @@ def settle_if(+db: String, session: String, attempt: String, success: Bool) -> I
     known : Bool <- present(db)
     settle_reads(db,session,attempt,success,known)
 
-# Completion consumes the admitted prompt and delivered guidance even when the
-# native observation cannot settle message_reads. A stopped session keeps its
-# owed input; consume_delivered_sql carries the same guard.
-def consume_delivered(+db: String, +session: String, +attempt: String, +initial_cursor: String, +delivered_cursor: String) -> IO(Unit):
+# Completion consumes the admitted prompt and forwarded guidance only while its
+# exited attempt and native identity remain current. The transaction records the
+# matching read rows as handled; a stop or identity change keeps input owed.
+def consume_delivered(+db: String, +session: String, +attempt: String, +native: String, +initial_cursor: String, +delivered_cursor: String) -> IO(Unit):
   do IO<Unit>:
-    stored : String <- IO.try(String,Store.transact_sql(db,Status.consume_delivered_sql(session,attempt,initial_cursor,delivered_cursor)))
+    stored : String <- IO.try(String,Store.transact_sql(db,Status.consume_delivered_sql(session,attempt,native,initial_cursor,delivered_cursor)))
     IO.pure(Unit,Unit{})
 
 def initial_observed(+db: String, +session: String, +attempt: String, +event: String) -> IO(Unit):
diff --git a/bend2/src/coordinator/message-status.bend b/bend2/src/coordinator/message-status.bend
index 0c1f4c61e..bfee543ec 100644
--- a/bend2/src/coordinator/message-status.bend
+++ b/bend2/src/coordinator/message-status.bend
@@ -53,12 +53,14 @@ def settle_sql(+session: String, +attempt: String, +identity: String) -> String:
 # prompt and every guidance frame forwarded to the native attempt before it
 # stopped. Input after the prompt that was not forwarded stays owed. The
 # initial cursor covers the prompt; the delivered cursor covers live guidance.
-def consume_delivered_sql(+session: String, +attempt: String, +initial_cursor: String, +delivered_cursor: String) -> String:
+def consume_delivered_sql(+session: String, +attempt: String, +native: String, +initial_cursor: String, +delivered_cursor: String) -> String:
   +receipt = "native-turn:" ++ attempt
-  "BEGIN IMMEDIATE;UPDATE messages SET receipt=coalesce(receipt," ++ q(receipt) ++ ") WHERE recipient=" ++ q(session)
-  ++ " AND receipt IS NULL AND NOT EXISTS(SELECT 1 FROM session_stops WHERE session=" ++ q(session) ++ ")"
-  ++ " AND (seq<=CAST(" ++ q(initial_cursor) ++ " AS INTEGER)"
-  ++ " OR (kind='guidance' AND seq<=CAST(" ++ q(delivered_cursor) ++ " AS INTEGER)));COMMIT;"
+  +eligible = "recipient=" ++ q(session) ++ " AND receipt IS NULL AND (seq<=CAST(" ++ q(initial_cursor) ++ " AS INTEGER) OR (kind='guidance' AND seq<=CAST(" ++ q(delivered_cursor) ++ " AS INTEGER)))"
+  +current = "EXISTS(SELECT 1 FROM executions e JOIN sessions s ON s.id=e.session WHERE e.session=" ++ q(session) ++ " AND e.id=" ++ q(attempt) ++ " AND e.phase='exited' AND s.native=" ++ q(native) ++ ")"
+  +unstopped = "NOT EXISTS(SELECT 1 FROM session_stops WHERE session=" ++ q(session) ++ ")"
+  "BEGIN IMMEDIATE;UPDATE message_reads SET handled=coalesce(handled," ++ q(receipt) ++ ") WHERE recipient=" ++ q(session) ++ " AND attempt=" ++ q(attempt) ++ " AND native=" ++ q(native)
+  ++ " AND message IN(SELECT id FROM messages WHERE " ++ eligible ++ ") AND " ++ current ++ " AND " ++ unstopped ++ ";"
+  ++ "UPDATE messages SET receipt=coalesce(receipt," ++ q(receipt) ++ ") WHERE " ++ eligible ++ " AND " ++ current ++ " AND " ++ unstopped ++ ";COMMIT;"
 
 # The admitted complete prompt supplies the exact stored header and body.
 def prompt_record_sql(+session: String, +attempt: String, +native: String, identity: String, +input: String) -> String:
diff --git a/bend2/src/coordinator/receive.bend b/bend2/src/coordinator/receive.bend
index 7d8c1f177..8c939a6e2 100644
--- a/bend2/src/coordinator/receive.bend
+++ b/bend2/src/coordinator/receive.bend
@@ -455,12 +455,12 @@ def completion_cursor(db: String, handle: U32, fallback: String) -> IO(String):
     +trimmed : String <- IO.pure(String,Tx.trim_nl(value))
     IO.pure(String,Bool.pick(String,String.is_empty(trimmed),fallback,trimmed))
 
-def consume_completed(+db: String, session: String, attempt: String, +initial_cursor: String, success: Bool, handle: U32) -> IO(Unit):
+def consume_completed(+db: String, session: String, attempt: String, native: String, +initial_cursor: String, success: Bool, handle: U32) -> IO(Unit):
   match success:
     case False{}: IO.pure(Unit,Unit{})
     case True{}: do IO<Unit>:
       delivered : String <- completion_cursor(db,handle,initial_cursor)
-      consumed : Unit <- AgentInput.consume_delivered(db,session,attempt,initial_cursor,delivered)
+      consumed : Unit <- AgentInput.consume_delivered(db,session,attempt,native,initial_cursor,delivered)
       IO.pure(Unit,Unit{})
 
 # Successful observations and complete recoverable provider errors resume all owed
@@ -479,7 +479,7 @@ def completed(+db: String, +session: String, +id: String, +log: String, +attempt
     transient : Bool <- transient_provider_error(db,outcome)
     +pending_cursor : String <- IO.pure(String,Bool.pick(String,Bool.and(failed,Bool.not(Bool.and(transient,observation_clear(outcome)))),cursor,"0"))
     success : Bool <- Turn.settlement_success(db,outcome)
-    consumed : Unit <- consume_completed(db,session,id,cursor,Bool.and(success,Bool.not(String.is_empty(attempt))),handle)
+    consumed : Unit <- consume_completed(db,session,id,native,cursor,Bool.and(success,Bool.not(String.is_empty(attempt))),handle)
     prepared : Unit <- Turn.prepare(db,session,id,log,stderr,outcome)
     observer_released : Unit <- release_observer(lock)
     native_released : Unit <- release_native(db,handle)
@@ -520,7 +520,7 @@ def restart_pending(+db: String, +session: String, +id: String, attempt: String,
 
 def complete_or_restart(db: String, session: String, id: String, log: String, stderr: String, attempt: String, cursor: String, native: String, cwd: String, handle: U32, lock: Maybe<U32>, outcome: Turn.Outcome, deliveries: List<Chan(Result<&1,&1,U32 & String,String>)>, again: String -> IO(Result<&1,&1,U32 & String,Unit>), gone: Bool, superseded: Bool) -> IO(Result<&1,&1,U32 & String,Unit>):
   match gone:
-    case False{}: completed(db,session,id,log,attempt,stderr,cursor,handle,lock,outcome,deliveries,again,superseded)
+    case False{}: completed(db,session,id,log,attempt,native,stderr,cursor,handle,lock,outcome,deliveries,again,superseded)
     case True{}: restart_pending(db,session,id,attempt,cursor,native,cwd,handle,lock,deliveries,again)
 
 def observed(+db: String, +session: String, +id: String, +log: String, cursor: String, +native: String, cwd: String, +attempt: String, handle: U32, lock: Maybe<U32>, +outcome: Turn.Outcome, deliveries: List<Chan(Result<&1,&1,U32 & String,String>)>, again: String -> IO(Result<&1,&1,U32 & String,Unit>), superseded: Bool) -> IO(Result<&1,&1,U32 & String,Unit>):
diff --git a/bend2/test/receive.py b/bend2/test/receive.py
index db605199f..b4d2045b4 100644
--- a/bend2/test/receive.py
+++ b/bend2/test/receive.py
@@ -4465,6 +4465,12 @@ class Receive(unittest.TestCase):
         self.finish(observer)
         self.assertEqual(self.coord('delivery', 'first-guidance')['receipt'],
                          'native-turn:' + attempt)
+        with sqlite3.connect(self.db.as_uri() + '?mode=ro', uri=True) as database:
+            reads = database.execute(
+                "SELECT handled FROM message_reads WHERE message='original' AND attempt=?",
