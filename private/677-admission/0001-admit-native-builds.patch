diff --git a/bend2/scripts/build-admission.py b/bend2/scripts/build-admission.py
new file mode 100755
index 00000000..998c06aa
--- /dev/null
+++ b/bend2/scripts/build-admission.py
@@ -0,0 +1,260 @@
+#!/usr/bin/env python3
+"""Admit one native build execution before it starts.
+
+#677: a repeated heavy validation must return the admitted execution instead of
+starting another one. #819: a full C generation is admitted only from actual
+host capacity. This wrapper is the shared entry used by build-native.sh, so
+developer, agent and workflow commands pass through the same decision.
+
+The decision is a non-blocking flock on one lock file in a host-wide directory
+selected by BATON2_BUILD_ADMISSION_DIR, or the per-user runtime directory
+otherwise. Every clone and worktree on the host therefore shares it. A full
+Main generation takes the exclusive lock; a focused build takes a shared lock.
+The wrapper refuses immediately with the exact observed capacity when another
+full generation holds the lock or when the host cannot supply the observed
+minimum. It never queues, waits, truncates output or estimates the task from
+caller input.
+
+Each attempt writes a durable JSON receipt before execution and updates it after
+the child exits. The child runs in a new session, so INT, TERM and HUP are
+forwarded to its whole process group and recorded. A cgroup memory bound is not
+imposed here because the script cannot create one without runner privilege; the
+receipt records the inherited cgroup and its memory.max for #819 admission.
+"""
+import argparse
+import fcntl
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+EX_TEMPFAIL = 75
+FULL = "full"
+FOCUSED = "focused"
+
+# Observed physical minima, not caller estimates. The #677 record measured a
+# completed Main generation at 110,205,349,888 bytes RSS; 128 GiB leaves that
+# peak headroom. Disk minima follow the recorded ENOSPC failures. A focused
+# build is bounded by the 8 GiB test cap, so 1 GiB of free capacity is the
+# admission floor for it.
+FLOORS = {
+    FULL: {"memory_kib": 128 * 1024 * 1024, "disk_kib": 16 * 1024 * 1024},
+    FOCUSED: {"memory_kib": 1 * 1024 * 1024, "disk_kib": 1 * 1024 * 1024},
+}
+
+
+def memory_available_kib():
+    try:
+        for line in Path("/proc/meminfo").read_text().splitlines():
+            if line.startswith("MemAvailable:"):
+                return int(line.split()[1])
+    except OSError:
+        return None
+    return None
+
+
+def disk_available_kib(path):
+    candidate = Path(path)
+    while not candidate.exists() and candidate != candidate.parent:
+        candidate = candidate.parent
+    usage = os.statvfs(candidate)
+    return (usage.f_bavail * usage.f_frsize) // 1024
+
+
+def admission_dir():
+    override = os.environ.get("BATON2_BUILD_ADMISSION_DIR")
+    if override:
+        return Path(override)
+    base = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
+    return base / ("baton2-build-admission-%d" % os.getuid())
+
+
+def source_identity(root):
+    def git(*args):
+        try:
+            return subprocess.check_output(
+                ["git", "-C", str(root), *args],
+                text=True, stderr=subprocess.DEVNULL).strip()
+        except (OSError, subprocess.CalledProcessError):
+            return ""
+    return {"commit": git("rev-parse", "HEAD"),
+            "status": git("status", "--porcelain=v1")}
+
+
+def classify(root, entry):
+    resolved = Path(entry)
+    if not resolved.is_absolute():
+        resolved = root / resolved
+    full_entry = (root / "bend2/src/coordinator/main.bend").resolve()
+    return FULL if resolved.resolve() == full_entry else FOCUSED
+
+
+def cgroup_identity():
+    try:
+        relative = Path("/proc/self/cgroup").read_text().strip().split("::", 1)[1]
+        memory_max = Path("/sys/fs/cgroup" + relative + "/memory.max").read_text().strip()
+        cpu_max = Path("/sys/fs/cgroup" + relative + "/cpu.max").read_text().strip()
+        return {"path": relative, "memory_max": memory_max, "cpu_max": cpu_max}
+    except OSError:
+        return {"path": "", "memory_max": "", "cpu_max": ""}
+
+
+def write_receipt(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
+    os.replace(temporary, path)
+
+
+def acquire(lock_path, exclusive):
+    lock_path.parent.mkdir(parents=True, exist_ok=True)
+    handle = os.open(lock_path, os.O_RDWR | os.O_CREAT, 0o644)
+    mode = fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH
+    try:
+        fcntl.flock(handle, mode | fcntl.LOCK_NB)
+    except BlockingIOError:
+        os.close(handle)
+        return None
+    return handle
+
+
+def refuse(kind, cause, condition, current, required, receipt_path, active_receipt=""):
+    document = {
+        "error": "build-admission-refused",
+        "kind": kind,
+        "cause": cause,
+        "condition": condition,
+        "current": current,
+        "required": required,
+        "receipt": str(receipt_path),
+        "active_receipt": active_receipt,
+        "next": "Wait for the recorded full generation to finish, free actual "
+                "capacity, or run a focused build.",
+    }
+    print(json.dumps(document, sort_keys=True), file=sys.stderr)
+    return EX_TEMPFAIL
+
+
+def run(args):
+    root = Path(args.root).resolve()
+    kind = classify(root, args.entry)
+    floors = FLOORS[kind]
+    directory = admission_dir()
+    started_at_ns = time.time_ns()
+    receipt_path = directory / "receipts" / ("%d-%d.json" % (started_at_ns, os.getpid()))
+    identity = source_identity(root)
+    output_path = Path(args.output)
+    if not output_path.is_absolute():
+        output_path = root / output_path
+    capacity = {
+        "memory_available_kib": args.memory_available_kib
+        if args.memory_available_kib is not None else memory_available_kib(),
+        "disk_available_kib": args.disk_available_kib
+        if args.disk_available_kib is not None else disk_available_kib(output_path),
+    }
+    receipt = {
+        "schema": 1,
+        "kind": kind,
+        "entry": args.entry,
+        "output": args.output,
+        "root": str(root),
+        "compiler": args.compiler,
+        "command": args.command,
+        "source": identity,
+        "capacity": capacity,
+        "required": floors,
+        "cgroup": cgroup_identity(),
+        "lock": str(directory / "build.lock"),
+        "started_at_ns": started_at_ns,
+    }
+    lock_path = directory / "build.lock"
+    lock = acquire(lock_path, kind == FULL)
+    if lock is None:
+        try:
+            active_receipt = lock_path.read_text().strip()
+        except OSError:
+            active_receipt = ""
+        receipt.update({"decision": "refused", "cause": "generation-in-flight",
+                        "active_receipt": active_receipt,
+                        "ended_at_ns": time.time_ns()})
+        write_receipt(receipt_path, receipt)
+        return refuse(kind, "generation-in-flight",
+                      "Another build holds the shared admission lock; a full "
+                      "generation requires exclusive custody.",
+                      capacity, floors, receipt_path, active_receipt)
+    os.ftruncate(lock, 0)
+    os.write(lock, str(receipt_path).encode())
+    os.fsync(lock)
+    memory = capacity["memory_available_kib"]
+    disk = capacity["disk_available_kib"]
+    if (memory is not None and memory < floors["memory_kib"]) or \
+            (disk is not None and disk < floors["disk_kib"]):
+        os.ftruncate(lock, 0)
+        os.close(lock)
+        receipt.update({"decision": "refused", "cause": "capacity-below-floor",
+                        "ended_at_ns": time.time_ns()})
+        write_receipt(receipt_path, receipt)
+        return refuse(kind, "capacity-below-floor",
+                      "Actual host capacity is below the observed minimum for "
+                      "this build kind.", capacity, floors, receipt_path)
+
+    receipt.update({"decision": "admitted"})
+    write_receipt(receipt_path, receipt)
+    child = subprocess.Popen(
+        args.command, cwd=str(root), start_new_session=True, pass_fds=(lock,),
+        env={**os.environ, "BATON2_BUILD_ADMITTED": "1"})
+    forwarded = []
+
+    def forward(number, _frame):
+        forwarded.append(number)
+        try:
+            os.killpg(child.pid, number)
+        except ProcessLookupError:
+            pass
+
+    previous = {}
+    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
+        previous[number] = signal.signal(number, forward)
+    try:
+        exit_code = child.wait()
+    finally:
+        for number, handler in previous.items():
+            signal.signal(number, handler)
+        os.ftruncate(lock, 0)
+        os.close(lock)
+    receipt.update({
+        "ended_at_ns": time.time_ns(),
+        "pid": child.pid,
+        "pgid": child.pid,
+        "exit_code": exit_code,
+        "signal_forwarded": forwarded,
+    })
+    if forwarded:
+        exit_code = 128 + forwarded[-1]
+        receipt["exit_code"] = exit_code
+    write_receipt(receipt_path, receipt)
+    return exit_code
+
+
+def main(argv):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--root", required=True)
+    parser.add_argument("--entry", required=True)
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--compiler", default="")
+    parser.add_argument("command", nargs=argparse.REMAINDER)
+    args = parser.parse_args(argv)
+    if args.command and args.command[0] == "--":
+        args.command = args.command[1:]
+    if not args.command:
+        parser.error("a command is required after --")
+    args.memory_available_kib = None
+    args.disk_available_kib = None
+    return run(args)
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
