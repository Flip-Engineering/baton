diff --git a/bend2/test/build-admission.py b/bend2/test/build-admission.py
new file mode 100755
index 00000000..a03517ac
--- /dev/null
+++ b/bend2/test/build-admission.py
@@ -0,0 +1,135 @@
+#!/usr/bin/env python3
+"""Tiny fixtures for the shared native build admission (#677, #819).
+
+No compiler is invoked. Every child is a short shell command, so the fixture
+stays far below the 8 GiB test cap.
+"""
+import contextlib
+import fcntl
+import importlib.util
+import io
+import json
+import os
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+MODULE = Path(__file__).resolve().parents[1] / "scripts" / "build-admission.py"
+SPEC = importlib.util.spec_from_file_location("build_admission", MODULE)
+ADMISSION = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(ADMISSION)
+
+HIGH_MEMORY = 256 * 1024 * 1024
+HIGH_DISK = 64 * 1024 * 1024
+
+
+class BuildAdmission(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name) / "repo"
+        (self.root / "bend2/src/coordinator").mkdir(parents=True)
+        (self.root / "bend2/tests").mkdir(parents=True)
+        self.output = str(self.root / ".scratch/bend2/tiny")
+        self.previous_admission = os.environ.get("BATON2_BUILD_ADMISSION_DIR")
+        os.environ["BATON2_BUILD_ADMISSION_DIR"] = str(Path(self.temp.name) / "admission")
+
+    def tearDown(self):
+        if self.previous_admission is None:
+            os.environ.pop("BATON2_BUILD_ADMISSION_DIR", None)
+        else:
+            os.environ["BATON2_BUILD_ADMISSION_DIR"] = self.previous_admission
+        self.temp.cleanup()
+
+    def arguments(self, entry="bend2/tests/tiny.bend", command=None,
+                  memory=HIGH_MEMORY, disk=HIGH_DISK):
+        return SimpleNamespace(
+            root=str(self.root), entry=entry, output=self.output, compiler="",
+            command=command or ["sh", "-c", "exit 0"],
+            memory_available_kib=memory, disk_available_kib=disk)
+
+    def receipts(self):
+        directory = ADMISSION.admission_dir() / "receipts"
+        return sorted(directory.glob("*.json")) if directory.exists() else []
+
+    def test_focused_build_is_admitted_with_group_identity(self):
+        exit_code = ADMISSION.run(self.arguments())
+        self.assertEqual(exit_code, 0)
+        receipt = json.loads(self.receipts()[-1].read_text())
+        self.assertEqual(receipt["kind"], ADMISSION.FOCUSED)
+        self.assertEqual(receipt["decision"], "admitted")
+        self.assertEqual(receipt["exit_code"], 0)
+        self.assertEqual(receipt["pgid"], receipt["pid"])
+        self.assertNotEqual(receipt["pgid"], os.getpid())
+
+    def test_full_build_is_refused_while_focused_build_holds_the_lock(self):
+        directory = ADMISSION.admission_dir()
+        directory.mkdir(parents=True)
+        held = os.open(directory / "build.lock", os.O_RDWR | os.O_CREAT, 0o644)
+        os.write(held, b"/retained/active-build.json")
+        fcntl.flock(held, fcntl.LOCK_SH | fcntl.LOCK_NB)
+        try:
+            with contextlib.redirect_stderr(io.StringIO()):
+                exit_code = ADMISSION.run(self.arguments(
+                    entry="bend2/src/coordinator/main.bend"))
+        finally:
+            os.close(held)
+        self.assertEqual(exit_code, ADMISSION.EX_TEMPFAIL)
+        receipt = json.loads(self.receipts()[-1].read_text())
+        self.assertEqual(receipt["kind"], ADMISSION.FULL)
+        self.assertEqual(receipt["decision"], "refused")
+        self.assertEqual(receipt["cause"], "generation-in-flight")
+        self.assertEqual(receipt["active_receipt"], "/retained/active-build.json")
+
+    def test_capacity_below_floor_is_refused(self):
+        with contextlib.redirect_stderr(io.StringIO()):
+            exit_code = ADMISSION.run(self.arguments(memory=512))
+        self.assertEqual(exit_code, ADMISSION.EX_TEMPFAIL)
+        receipt = json.loads(self.receipts()[-1].read_text())
+        self.assertEqual(receipt["decision"], "refused")
+        self.assertEqual(receipt["cause"], "capacity-below-floor")
+        self.assertEqual(receipt["capacity"]["memory_available_kib"], 512)
+
+    def test_full_build_is_admitted_when_capacity_and_lock_are_free(self):
+        exit_code = ADMISSION.run(self.arguments(
+            entry="bend2/src/coordinator/main.bend"))
+        self.assertEqual(exit_code, 0)
+        receipt = json.loads(self.receipts()[-1].read_text())
+        self.assertEqual(receipt["kind"], ADMISSION.FULL)
+        self.assertEqual(receipt["decision"], "admitted")
+
+    def test_termination_is_forwarded_to_the_build_process_group(self):
+        program = (
+            "import importlib.util, sys\n"
+            "from types import SimpleNamespace\n"
+            "spec = importlib.util.spec_from_file_location('admission', %r)\n"
+            "module = importlib.util.module_from_spec(spec)\n"
+            "spec.loader.exec_module(module)\n"
+            "args = SimpleNamespace(root=%r, entry='bend2/tests/tiny.bend', "
+            "output=%r, compiler='', command=['sh', '-c', 'sleep 30'], "
+            "memory_available_kib=%d, disk_available_kib=%d)\n"
+            "sys.exit(module.run(args))\n"
+        ) % (str(MODULE), str(self.root), self.output, HIGH_MEMORY, HIGH_DISK)
+        command = [sys.executable, "-c", program]
+        wrapper = subprocess.Popen(command, stdout=subprocess.DEVNULL,
+                                   stderr=subprocess.DEVNULL)
+        try:
+            time.sleep(0.75)
+            wrapper.send_signal(signal.SIGTERM)
+            wrapper.wait(timeout=10)
+        finally:
+            if wrapper.poll() is None:
+                wrapper.kill()
+                wrapper.wait()
+        self.assertIn(wrapper.returncode, (128 + signal.SIGTERM, -signal.SIGTERM))
+        receipt = json.loads(self.receipts()[-1].read_text())
+        self.assertIn(signal.SIGTERM, receipt["signal_forwarded"])
+        self.assertEqual(receipt["pgid"], receipt["pid"])
+
+
+if __name__ == "__main__":
+    unittest.main()
