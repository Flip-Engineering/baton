From 1647619021e091edd5db54003e45c1a83f9d8581 Mon Sep 17 00:00:00 2001
From: flip-engineer <will.a.hargis@gmail.com>
Date: Sat, 17 Oct 2026 16:59:36 -0700
Subject: [PATCH] Register a receiver for receiver-less existing dispatches

An existing session with no command-line receiver and no direct Codex App
route admitted continuation input without any launch path, so the session
reported endpoint-absent and the input stayed unread. Resolve the recorded
harness from PATH, register that receiver before admission, and keep valid
non-receiver endpoints and the Codex App route unchanged.

Add a focused fixture test for the missing-receiver path.
---
 bend2/harness/task-start.mjs | 22 +++++++++++++++++-----
 bend2/test/task-start.py     | 25 +++++++++++++++++++++++++
 2 files changed, 42 insertions(+), 5 deletions(-)

diff --git a/bend2/harness/task-start.mjs b/bend2/harness/task-start.mjs
index 306fdf3f..e1f84005 100644
--- a/bend2/harness/task-start.mjs
+++ b/bend2/harness/task-start.mjs
@@ -323,12 +323,24 @@ export function startTask(executable, database, argv) {
       'The selected conversation records a different working directory.',
       'Use receiver SESSION COMMAND LOG CWD to relocate it explicitly, then retry the task.');
     const receiver = recordedReceiver(selected);
-    const command = options.command ?? receiver?.command ?? (!selected ? executableInPath(route.harness) : undefined);
+    // An existing session with no command-line receiver and no direct Codex App
+    // route cannot launch admitted input. Resolve its recorded harness from PATH
+    // and register that receiver, as a new session already does.
+    const directAppRoute = Boolean(selected && selected.harness === 'codex'
+      && selected.native && !selected.endpoint);
+    const endpointAbsent = !Array.isArray(selected?.endpointArgv)
+      || selected.endpointArgv.length === 0 || !selected.endpointArgv[0];
+    const receiverMissing = Boolean(selected && !receiver && !directAppRoute
+      && options.command === undefined && endpointAbsent);
+    const command = options.command ?? receiver?.command
+      ?? (receiverMissing || !selected ? executableInPath(route.harness) : undefined);
     result.command = { executable: command ?? null,
-      source: options.command !== undefined ? 'explicit' : receiver ? 'recorded-receiver' : selected ? 'recorded-endpoint' : 'PATH' };
+      source: options.command !== undefined ? 'explicit' : receiver ? 'recorded-receiver'
+        : receiverMissing ? 'PATH' : selected ? 'recorded-endpoint' : 'PATH' };
     const log = resolve(options.log ?? receiver?.log ??
       join(`${database}.transcripts`, Buffer.from(sessionId).toString('hex'), requestId, 'native.jsonl'));
-    result.outputLog = selected && !options.command && options.log === undefined ? receiver?.log ?? null : log;
+    result.outputLog = selected && !options.command && options.log === undefined && !receiverMissing
+      ? receiver?.log ?? null : log;
     let profile = null;
     if (named?.profile) {
       const store = resolveRouteProfile(saved, route.harness, named.profile);
@@ -358,9 +370,9 @@ export function startTask(executable, database, argv) {
         native('configure', sessionId, route.harness, route.model, route.effort,
           command ?? '', log, selected.harness, selected.model, selected.effort);
       }
-      if (options.command !== undefined) {
+      if (options.command !== undefined || receiverMissing) {
         mkdirSync(dirname(log), { recursive: true, mode: 0o700 });
-        native('receiver', sessionId, options.command, log);
+        native('receiver', sessionId, options.command ?? command, log);
       }
     }
     if (profile) native('profile-bind', sessionId, route.harness, profile.label, profile.store);
diff --git a/bend2/test/task-start.py b/bend2/test/task-start.py
index da42d498..58458ed7 100644
--- a/bend2/test/task-start.py
+++ b/bend2/test/task-start.py
@@ -264,6 +264,31 @@ class TaskStart(unittest.TestCase):
         self.assertEqual(native['args'][native['args'].index('--thinking') + 1], 'high')
         self.failed_turn('named', stream, 'Retain the named route result.')
 
+    def test_existing_session_without_receiver_registers_recorded_harness_receiver(self):
+        session = 'receiver-less'
+        self.route(session)
+        self.call('join', session, 'root', 'codex', 'gpt-6-astra', 'low', self.repo)
+        self.assertFalse(self.call('session', session)['endpointArgv'])
+        directory = self.directory / 'receiver-less-path'
+        directory.mkdir()
+        (directory / 'codex').symlink_to(self.fixture)
+        self.environment['PATH'] = str(directory) + ':' + self.environment['PATH']
+        body = 'Deliver to an existing session with no recorded receiver λ🙂.'
+        result = self.task_call('--sender', 'root', '--to', session, '--text', body)
+        self.assertEqual(result['status'], 'admitted')
+        self.assertEqual(result['command'], {'executable': str(self.fixture.resolve()), 'source': 'PATH'})
+        steps = [step['argv'][2] for step in result['steps']]
+        self.assertLess(steps.index('receiver'), steps.index('message-batch-file'))
+        state = self.call('session', session)
+        self.assertEqual(state['blockedCause'], '')
+        self.assertEqual(state['endpointArgv'][-7:-5], ['receive', session])
+        self.assertIn(str(self.fixture.resolve()), state['endpointArgv'])
+        self.assert_retained_input(result, body)
+        stream, native = self.accept(session)
+        self.assert_initial_prompt(result, body, native)
+        self.finish(stream, 'Completed the receiver-less dispatch task.')
+        self.exited(session)
+
     def test_missing_route_does_not_choose_first_saved_route_or_an_existing_session(self):
         self.settings([{'name': 'first', 'harness': 'codex', 'model': 'gpt-6-astra', 'effort': 'low'}])
         result = self.task_call('Task text is retained when defaults are incomplete.',
