From 65983f8864a547c1b900af748b2efc62b79a22e0 Mon Sep 17 00:00:00 2001
From: flip-engineer <will.a.hargis@gmail.com>
Date: Sun, 18 Oct 2026 01:05:15 -0700
Subject: [PATCH 19/19] Bind the far continuation session to the window
 provider (#797, #823)

The ported session helper gave far2 the model far2-kimi/kimi-for-coding while the fixture's window rows bind provider kimi-code, so the gate found no matching window and far-continuation-held failed. The far session now records kimi-code/kimi-for-coding; the account still isolates the case. Test-only; production wake eligibility is unchanged.
---
 bend2/test/usage-windows-wake.bend | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/bend2/test/usage-windows-wake.bend b/bend2/test/usage-windows-wake.bend
index 7f6d1d3f9..e58a72c0b 100644
--- a/bend2/test/usage-windows-wake.bend
+++ b/bend2/test/usage-windows-wake.bend
@@ -66,7 +66,9 @@ def message(+db: String, +session: String, +message: String, +receipt: String) -
   query(db,"INSERT INTO messages(id,sender,recipient,kind,body,receipt) VALUES(" ++ C.q(message) ++ ",'root'," ++ C.q(session) ++ ",'guidance','owed',nullif(" ++ C.q(receipt) ++ ",''));")
 
 def session(+db: String, +id: String) -> IO(Unit):
-  query(db,"INSERT OR IGNORE INTO sessions(id,parent,harness,model,effort,native,endpoint) VALUES(" ++ C.q(id) ++ ",'root','omp'," ++ C.q(id ++ "-kimi/kimi-for-coding") ++ ",'high','','');")
+  # The window rows bind provider 'kimi-code'; the session model must name that
+  # provider or the gate sees no matching window. Account isolates the cases.
+  query(db,"INSERT OR IGNORE INTO sessions(id,parent,harness,model,effort,native,endpoint) VALUES(" ++ C.q(id) ++ ",'root','omp','kimi-code/kimi-for-coding','high','','');")
 
 def handled_case(+db: String, +self: String) -> IO(Unit):
   do IO<Unit>:
