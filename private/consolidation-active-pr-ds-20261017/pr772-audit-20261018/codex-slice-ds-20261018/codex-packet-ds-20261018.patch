+static int bc_pipe(int fds[2]) {
+  if(pipe(fds))return errno;
+  if(fcntl(fds[0],F_SETFD,FD_CLOEXEC)<0 || fcntl(fds[1],F_SETFD,FD_CLOEXEC)<0) {
+    int error=errno;close(fds[0]);close(fds[1]);return error;
+  }
+  return 0;
+}
