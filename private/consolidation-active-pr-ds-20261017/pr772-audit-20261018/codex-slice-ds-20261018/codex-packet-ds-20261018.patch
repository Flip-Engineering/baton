+  for(unsigned i=0;i<8;i++)final[padded-1-i]=(unsigned char)(bits>>(8*i));
+  bc_sha1_block(state,final);if(padded==128)bc_sha1_block(state,final+64);
+  for(unsigned i=0;i<20;i++)digest[i]=(unsigned char)(state[i/4]>>(24-8*(i%4)));
