#!/bin/sh
# Baton pre-commit: the surface gate (issue #262). Enable once per clone with
#   git config core.hooksPath .githooks
# Refuses a commit whose surface names break the docs/36 grammar or whose generated artifacts
# (surface inventory, CLI.md/MCP.md blocks, parity matrix) are stale, or whose advertised MCP
# tools do not resolve at tools/call. Regenerate with: node impl/scripts/surface-gate.mjs --write
#
# The gate runs on the node named by BATON_NODE, else the ambient `node`, and refuses by name when
# that node is below impl/package.json's engines range (#303). A snapshot of unfinished work is a
# record, not a landing: preserve it with `git commit --no-verify` (the runtime's own progress
# checkpoints commit through plumbing and never reach this hook).
set -e
root="$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^impl/(src|scripts|CLI\.md|MCP\.md)|^docs/reference/inventory/'; then
  node_bin="${BATON_NODE:-node}"
  version="$("$node_bin" --version 2>/dev/null || echo unknown)"
  major="${version#v}"; major="${major%%.*}"
  required="$(sed -n 's/.*"node": *">=\([0-9][0-9]*\).*/\1/p' "$root/impl/package.json" | head -1)"
  if [ -n "$required" ] && [ "$version" != unknown ] && [ "$major" -lt "$required" ]; then
    echo "pre-commit: $node_bin is $version; impl/package.json engines.node requires >=$required. Set BATON_NODE to the project toolchain." >&2
    exit 1
  fi
  if ! (cd "$root/impl" && "$node_bin" scripts/surface-gate.mjs); then
    echo "pre-commit: the surface gate refused under $node_bin $version (engines >=$required). Regenerate with: node impl/scripts/surface-gate.mjs --write. A snapshot of unfinished work is not a landing: preserve it with --no-verify." >&2
    exit 1
  fi
fi
