ble_members (ensemble TEXT NOT NULL REFERENCES ensembles(id),session TEXT NOT NULL REFERENCES sessions(id),PRIMARY KEY(ensemble,session));CREATE TABLE IF NOT EXISTS sections (ensemble TEXT NOT NULL REFERENCES ensembles(id),id TEXT NOT NULL,capability TEXT NOT NULL CHECK(length(capability)>0),PRIMARY KEY(ensemble,id));CREATE TABLE IF NOT EXISTS section_members (ensemble TEXT NOT NULL,section TEXT NOT NULL,session TEXT NOT NULL,PRIMARY KEY(ensemble,section,session),FOREIGN KEY(ensemble,section) REFERENCES sections(ensemble,id),FOREIGN KEY(ensemble,session) REFERENCES ensemble_members(ensemble,session) ON DELETE CASCADE);CREATE TABLE IF NOT EXISTS knowledge (id TEXT UNIQUE NOT NULL, author TEXT NOT NULL, claim TEXT NOT NULL, evidence TEXT NOT NULL, limits TEXT NOT NULL);CREATE TABLE IF NOT EXISTS knowledge_promotions (id TEXT UNIQUE NOT NULL, finding TEXT NOT NULL, author TEXT NOT NULL, source TEXT NOT NULL, destination TEXT NOT NULL, promoted_by TEXT NOT NULL);WITH RECURSIVE chain(id) AS (SELECT 'operator' UNION ALL SELECT s.parent FROM sessions s JOIN chain c ON s.id=c.id WHERE s.parent IS NOT NULL) SELECT coalesce(json_group_array(json(item)),json('[]')) FROM (SELECT json_object('id',k.id,'author',k.author,'claim',k.claim,'evidence',k.evidence,'evidenceMessage',(SELECT json_object('id',id,'sender',sender,'recipient',recipient,'body',body) FROM messages WHERE id=substr(k.evidence,9)),'limits',k.limits,'destinations',(SELECT coalesce(json_group_array(p.destination),json('[]')) FROM knowledge_promotions p WHERE p.finding=k.id AND (EXISTS(SELECT 1 FROM chain c WHERE c.id=p.destination) OR EXISTS(SELECT 1 FROM sessions d WHERE d.id=p.destination AND d.parent='operator'))),'promotions',(SELECT coalesce(json_group_array(json(item)),json('[]')) FROM (SELECT json_object('finding',p.finding,'author',p.author,'source',p.source,'destination',p.destination,'promotedBy',p.promoted_by) AS item FROM knowledge_promotions p WHERE p.finding=k.id AND (EXISTS(SELECT 1 FROM chain c WHERE c.id=p.destination) OR EXISTS(SELECT 1 FROM sessions d WHERE d.id=p.destination AND d.parent='operator'))))) AS item FROM knowledge k WHERE k.author='operator' OR EXISTS(SELECT 1 FROM sessions a WHERE a.id=k.author AND a.parent='operator') OR EXISTS(SELECT 1 FROM knowledge_promotions p WHERE p.finding=k.id AND (EXISTS(SELECT 1 FROM chain c WHERE c.id=p.destination) OR EXISTS(SELECT 1 FROM sessions d WHERE d.id=p.destination AND d.parent='operator'))) ORDER BY k.rowid);COMMIT;", R, x => IO.pass(String, x, R, k))
