+    const review = pid === 'local-owner' || pid.startsWith('service-');
+    const activeRun = pid.startsWith('worker:') ? resolveSeat(pid) : undefined;
+    if (scope === 'shared') {
+      if (activeRun !== undefined && activeRun !== runId) return false; // H1.1 own-run predicate
+      return true;
+    }
