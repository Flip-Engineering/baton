diff --git a/fframes-3d/tests/materials.rs b/fframes-3d/tests/materials.rs
index 08d282d4..569fcbbd 100644
--- a/fframes-3d/tests/materials.rs
+++ b/fframes-3d/tests/materials.rs
@@ -359,3 +359,16 @@ fn the_skinned_deform_is_spliced_where_the_marker_is() {
     let stub = "fn fframes_deform(position: ptr<function, vec3f>, normal: ptr<function, vec3f>, vertex: u32, skin: vec4<u32>) {\n    *normal = *normal;\n    *position = *position;\n    _ = vertex + skin.x;\n}\n";
     validate("skin/shadow-with-deform", &format!("{stub}{module}"));
 }
+
+#[test]
+fn the_fabric_path_refuses_the_effects_it_does_not_carry() {
+    // The uncut shell and the zone-driven wear are the two effects a garment scene could ask for
+    // and silently not get; both are classified as unsupported, so require() fails and
+    // require_classified() accepts the name as considered.
+    let fabric = fframes_3d::fabric([0.2, 0.3, 0.4, 0.0]);
+    for feature in ["garmentCut", "wear.zones", "sheen", "fibreLobe", "asperity"] {
+        assert!(fabric.require(feature).is_err(), "{feature} must be refused");
+        assert!(fabric.require_classified(&[feature]).is_ok(), "{feature} must be classified");
+    }
+    assert!(!fabric.features.iter().any(|f| f == "garmentCut"));
+}
